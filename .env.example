DATABASE_URL="postgresql://ember:ember@127.0.0.1:55432/ember?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_PASSWORD="forja"

# Optional. Without these keys, images stay on disk under public/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional Amazon S3. Used first when all three values are set.
AWS_S3_BUCKET=""
AWS_S3_REGION="eu-west-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Optional Stripe test mode. Without a secret key, checkout completes locally.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Optional Resend. Without a key, transactional mail is stored in EmailLog.
RESEND_API_KEY=""
RESEND_FROM="FORJA <onboarding@resend.dev>"
